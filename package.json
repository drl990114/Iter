{
  "name": "iter",
  "version": "0.1.0",
  "license": "MIT",
  "engines": {
    "node": ">=22.20.0"
  },
  "description": "One portable product iteration skill for Agent Skills-compatible harnesses",
  "type": "module",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "cordis.patch.yml",
    ".codex-plugin/plugin.json",
    ".claude-plugin/plugin.json",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "docs/**/*.md",
    "docs/demo/*",
    "docs/demo/evidence/*",
    "examples/note-counter/*",
    "examples/note-counter-completed/*",
    "skills/iterate-product/SKILL.md",
    "skills/iterate-product/LICENSE.txt",
    "skills/iterate-product/agents/*.yaml",
    "skills/iterate-product/references/**/*.md",
    "skills/iterate-product/assets/*",
    "skills/iterate-product/scripts/*.py"
  ],
  "scripts": {
    "release": "node scripts/release.mjs dispatch",
    "test": "node --test tests/*.test.mjs",
    "test:install": "node --test tests/install.integration.mjs",
    "test:python": "node tests/run-python.mjs",
    "check": "node --check index.mjs && node --check tests/harness.test.mjs && node --check tests/package-fixture.mjs && node --check tests/install.integration.mjs && node --check tests/run-python.mjs && node --check tests/distribution.test.mjs && node --check scripts/release.mjs && node --check tests/release.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-skill-filesystem": "0.0.1-rc.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-skill": "0.0.1-rc.3",
    "@deepseek-ai/dsh-skill-filesystem": "0.0.1-rc.3",
    "@release-it/bumper": "7.0.6",
    "@release-it/conventional-changelog": "11.0.1",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "release-it": "20.2.1",
    "semver": "7.8.5",
    "skills": "1.5.23",
    "tar": "7.5.22",
    "yaml": "2.9.0"
  },
  "homepage": "https://github.com/drl990114/Iter",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drl990114/Iter.git"
  }
}
