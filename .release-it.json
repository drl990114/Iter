{
  "git": {
    "requireCleanWorkingDir": true,
    "requireUpstream": false,
    "commit": false,
    "tag": false,
    "push": false,
    "tagName": "v${version}"
  },
  "npm": {
    "publish": false,
    "allowSameVersion": true,
    "versionArgs": ["--ignore-scripts"]
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@release-it/bumper": {
      "out": [".codex-plugin/plugin.json", ".claude-plugin/plugin.json"]
    },
    "@release-it/conventional-changelog": {
      "preset": { "name": "conventionalcommits" },
      "infile": false
    }
  }
}
